{
  "name": "@abcp/agent-sdk",
  "version": "0.16.0",
  "description": "Agent typed client SDK for TypeScript over Connect (agent.v1.AgentService + agent.v1.AdminService). Web + Node transports.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "types": "./src/index.ts",
    "default": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abcp-sdk/agent-sdk-typescript.git"
  },
  "license": "Apache-2.0"
}
